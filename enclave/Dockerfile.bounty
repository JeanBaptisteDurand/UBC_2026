# Image de l'enclave ArcHive, produit « Prime scellée ». Déployable sur Phala Cloud (dstack TDX).
# Le rejeu est RÉEL et FIDÈLE : arc-anvil (Arc Foundry, circlefin/arc-foundry, fork de Foundry par Circle) forke Arc au
# bloc N avec les précompilés d'Arc (USDC natif, liste de blocage, journaux EIP-7708) : aucune émulation. L'archive est
# épinglée par version ET par empreinte sha256 (publiée avec la release, attestation sigstore) : l'image reste reproductible.
# Debian trixie (glibc 2.41) : arc-anvil exige glibc ≥ 2.39 (bookworm n'a que 2.36)
FROM node:22-trixie-slim@sha256:be1e2a3dc2c4fd68cdfadad2a696a280e0d2749098bee509230174d72fb768c6
ARG ARC_FOUNDRY_VERSION=v0.8.0-4
ARG ARC_FOUNDRY_SHA256=78330505af7dc0d2c9b55fc1aed00d9d063581bb57054949d31ef1c1b4bdbc5e
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /tmp/arc-foundry.tgz "https://github.com/circlefin/arc-foundry/releases/download/${ARC_FOUNDRY_VERSION}/arc-foundry-${ARC_FOUNDRY_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
 && echo "${ARC_FOUNDRY_SHA256}  /tmp/arc-foundry.tgz" | sha256sum -c - \
 && mkdir -p /tmp/af && tar -xzf /tmp/arc-foundry.tgz -C /tmp/af anvil && mv /tmp/af/anvil /usr/local/bin/arc-anvil \
 && rm -rf /tmp/af /tmp/arc-foundry.tgz && arc-anvil --version
ENV ANVIL_BIN=arc-anvil
WORKDIR /app
# dépendances figées par le fichier de verrouillage : deux constructions du même code donnent la même image
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --legacy-peer-deps
COPY tsconfig.json ./
COPY src ./src
COPY products ./products
RUN node_modules/.bin/esbuild products/sealed-bounty/server.ts --bundle --platform=node --format=esm --outfile=dist/sealed-bounty.mjs --packages=external
ENV PORT=8803
EXPOSE 8803
CMD ["node", "dist/sealed-bounty.mjs"]
