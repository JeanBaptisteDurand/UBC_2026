# ArcHive "copilot-enclave" image: the copilot (services/copilot, the same code that serves the site) inside an Intel
# TDX enclave (Phala dstack), with the enclave kit: keys created in memory, POST /attest (a dstack quote bound to the
# operator and the product, OPERATOR_ALLOWLIST), GET /pubkeys, and an encrypted conversation (HPKE) besides plain mode.
# Entry point: services/copilot/src/enclave-server.ts. Configuration: services/copilot/src/enclave-config.ts.
# The same image serves the console or the site's AskHive panel, selected by COPILOT_SURFACE, written in clear (hence
# measured) in the compose file: enclave/phala/copilot-v21.yml (console), enclave/phala/copilot-site-v22.yml (site:
# replies sealed and signed by the enclave's key, services/copilot/src/enclave-site.ts).
#
# Built from the repository root (the code comes from three folders), for linux/amd64 (Phala's TDX VMs), without a
# provenance attestation (a plain image: one manifest, whose digest is the one the compose file pins) and with fixed
# timestamps (SOURCE_DATE_EPOCH + rewrite-timestamp: two builds of the same sources give the same layers):
#   SOURCE_DATE_EPOCH=1794960000 docker buildx build --platform linux/amd64 -f enclave/Dockerfile.copilot \
#     --provenance=false --sbom=false --build-arg SOURCE_DATE_EPOCH \
#     --output type=docker,name=archive-copilot-enclave:v22-site,rewrite-timestamp=true .
#   (to publish the image: the same command with
#    --output type=image,name=ghcr.io/<account>/archive-copilot-enclave:v22-site,push=true,rewrite-timestamp=true)
# enclave/Dockerfile.copilot.dockerignore sends the builder only the sources and lockfiles the image uses: never
# .secrets/, .git/, or local node_modules.
# Reproducible: the base image is pinned by digest (the same one as the services behind the site), dependencies are
# pinned by the lockfiles (npm ci), the application is bundled into one JavaScript file (the model verifier's locked
# dependencies sit beside it, see below), and no system package is installed (Node ships its own certificate
# authorities).

FROM node:22-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS build
WORKDIR /src
COPY packages/sdk/package.json packages/sdk/package-lock.json packages/sdk/
COPY services/copilot/package.json services/copilot/package-lock.json services/copilot/
COPY enclave/package.json enclave/package-lock.json enclave/
RUN cd /src/packages/sdk && npm ci --no-audit --no-fund --omit=dev \
 && cd /src/services/copilot && npm ci --no-audit --no-fund \
 && cd /src/enclave && npm ci --no-audit --no-fund --omit=dev --legacy-peer-deps
COPY packages/sdk/src packages/sdk/src
COPY enclave/src enclave/src
COPY services/copilot/src services/copilot/src
# one file: the copilot, the SDK (sources) and the enclave kit; esbuild is the version locked by the copilot (via tsx)
RUN cd /src/services/copilot && node_modules/.bin/esbuild src/enclave-server.ts --bundle --platform=node --format=esm \
      --log-level=warning --outfile=/out/copilot-enclave.mjs --alias:@arcvault/sdk=/src/packages/sdk/src/index.ts \
      --external:@phala/aci-verifier \
      '--banner:js=import { createRequire as _cr } from "module"; const require = _cr(import.meta.url);'

FROM node:22-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
WORKDIR /app
COPY --from=build /out/copilot-enclave.mjs ./copilot-enclave.mjs
# the model provider's verifier (@phala/aci-verifier, with dcap-qvl in WebAssembly) stays an external module: its
# dependencies come from the enclave's lockfile (npm ci --omit=dev above), copied as they are
COPY --from=build /src/enclave/node_modules ./node_modules
# the deployed stacks (contract addresses, never hard-coded): DEPLOYMENTS=/app/deployments/<file>, written in clear
# in the compose file (measured); the file itself is inside the image (pinned by digest)
COPY deployments.*.json ./deployments/
COPY docs/history/deployments.v2*.json ./deployments/
ENV PORT=8808
EXPOSE 8808
CMD ["node", "copilot-enclave.mjs"]
