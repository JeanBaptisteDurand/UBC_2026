# Copilote : OpenAI (ou compatible, ex. DeepSeek via OPENAI_BASE_URL)
COPILOT_PROVIDER=openai
OPENAI_API_KEY=sk-...
COPILOT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com   # pour DeepSeek

# Origines autorisées (CORS + refus côté serveur), séparées par des virgules. Défaut : le site seulement.
# En développement (site servi par vite), ajouter son origine, ex. :
# ALLOWED_ORIGINS=https://archive.62-171-153-35.sslip.io,http://localhost:5173

# API ArcHive : les listes (enclaves, primes, produits, sessions, activité) viennent de son index d'événements,
# jamais de l'explorateur. Défaut : l'API publique. Sur le VPS, dans le réseau Docker : http://api:8809
# ARCHIVE_API=https://archive.62-171-153-35.sslip.io/api

# Débit par IP (X-Forwarded-For posé par Caddy) et plafond global quotidien de requêtes au modèle (0 = aucun)
# COPILOT_RATE_PER_MINUTE=20
# COPILOT_RATE_PER_DAY=300
# COPILOT_GLOBAL_PER_DAY=2000

# Coût borné par requête : jetons de sortie par appel au modèle ; caractères ajoutés à l'historique pendant une requête
# (résultats d'outils ET sorties du modèle) ; entrée cumulée de tous les appels au modèle d'une requête (borne dure)
# COPILOT_MAX_TOKENS=2000
# COPILOT_MAX_TOOL_CHARS=40000
# COPILOT_MAX_INPUT_CHARS=160000

# URL privées (localhost, 10.x…) pour /attest et /pubkeys : jamais sur un serveur public
# COPILOT_ALLOW_PRIVATE_URLS=1

# DEBUG est retiré de l'environnement au démarrage (openai@4 journaliserait la clé et la conversation) ; dans une
# enclave, toute valeur non vide de DEBUG arrête le démarrage. Copilote EN ENCLAVE seulement (enclave-config.ts) :
# COPILOT_PROXY_TOKEN (variable CHIFFRÉE, 32 octets au moins, même valeur dans nginx) : sans lui, l'enclave refuse
# POST /chat (403 proxy_required). Le copilote du VPS ne s'en sert pas.

# Surface servie (16/11) : console (défaut : la bulle de la console, servie sous /copilot/, inchangée) ou site (le panneau
# du front, servi sous /copilot-site/ : outils ui_navigate, ui_highlight, ui_demo validés ici et exécutés par le navigateur,
# champ `page` de la requête dit en une ligne de l'invite, base de connaissances des pages du site). Autre valeur : arrêt.
# COPILOT_SURFACE=console
