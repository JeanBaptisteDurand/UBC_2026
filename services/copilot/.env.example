# Copilot model: OpenAI, or any compatible API (e.g. DeepSeek through OPENAI_BASE_URL)
COPILOT_PROVIDER=openai
OPENAI_API_KEY=sk-...
COPILOT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com   # for DeepSeek

# Allowed origins (CORS, and refused on the server side), comma-separated. Default: the site only.
# In development (site served by Vite), add its origin, e.g.:
# ALLOWED_ORIGINS=https://archive.62-171-153-35.sslip.io,http://localhost:5173

# ArcHive API: the lists (enclaves, bounties, products, sessions, activity) come from its event index,
# never from the explorer. Default: the public API. On the server, inside the Docker network: http://api:8809
# ARCHIVE_API=https://archive.62-171-153-35.sslip.io/api

# Per-IP rate limit (X-Forwarded-For set by Caddy) and a daily global cap on model requests (0 = none)
# COPILOT_RATE_PER_MINUTE=20
# COPILOT_RATE_PER_DAY=300
# COPILOT_GLOBAL_PER_DAY=2000

# Bounded cost per request: output tokens per model call; characters added to the history during a request
# (tool results AND model outputs); the summed input of all model calls of a request (a hard bound)
# COPILOT_MAX_TOKENS=2000
# COPILOT_MAX_TOOL_CHARS=40000
# COPILOT_MAX_INPUT_CHARS=160000

# Private URLs (localhost, 10.x…) for /attest and /pubkeys: never on a public server
# COPILOT_ALLOW_PRIVATE_URLS=1

# DEBUG is removed from the environment at start-up (openai@4 would log the key and the conversation); in an
# enclave, any non-empty DEBUG stops the start. Copilot IN AN ENCLAVE only (enclave-config.ts):
# COPILOT_PROXY_TOKEN (an ENCRYPTED variable, at least 32 bytes, the same value in nginx): without it, the enclave
# refuses POST /chat (403 proxy_required). The server's copilot does not use it.

# Surface served: console (default: the console's bubble, served under /copilot/) or site (AskHive, the front's panel,
# served under /copilot-site/: interface tools validated here and run by the browser, the request's `page` field said
# in one prompt line, the site's knowledge base). Any other value stops the start.
# COPILOT_SURFACE=console
