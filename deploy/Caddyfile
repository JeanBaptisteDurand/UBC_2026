# ArcHive (un seul projet depuis le 16/11) : le front de Florent à la racine, la console sous /console/, le copilote du site
# (/copilot-site/) et le serveur MCP en HTTP (/mcp). Caddy ne relit ce fichier qu'à sa recréation : deploy.sh s'en charge.
# ArcHive en HTTPS, une seule origine (le chiffrement HPKE du navigateur exige un contexte sécurisé).
# Certificat obtenu et renouvelé automatiquement par Caddy (Let's Encrypt, sinon ZeroSSL).
# Caddy remplace tout X-Forwarded-For reçu du client par l'IP réelle de la connexion (aucun proxy de confiance
# n'est déclaré) : l'API s'en sert pour limiter le débit par IP.
#
# arc-hive.xyz (A @ et www vers 62.171.153.35) sert le MÊME
# site, l'adresse sslip.io reste servie telle quelle (enclaves, registrars, scripts d'opérateur et liens publiés
# l'appellent). Deux réglages tant que tout n'est pas reconstruit sur le nouveau nom :
#  - la console (/console/) est construite avec l'adresse sslip.io en dur (build.sh, PUBLIC_URL) : la CSP du nouveau nom
#    bloquerait ses appels, on l'envoie donc sur sslip.io ;
#  - les copilotes (serveur et enclave, ALLOWED_ORIGINS mesurée dans la VM) n'acceptent que l'origine sslip.io : Caddy
#    leur présente l'origine https://arc-hive.xyz (notre propre site, même serveur) comme celle de sslip.io.
#  Les signatures de wallet (EIP-4361 : appairage, clés d'opérateur) restent liées à sslip.io (WEB_URL de l'API) : sur le
#  nouveau nom, le front affiche déjà « mauvais site » avec le lien de la console.
#  Pour faire d'arc-hive.xyz le nom principal : PUBLIC_URL et WEB_URL, ALLOWED_ORIGINS des enclaves (au passage en v3).
www.arc-hive.xyz {
	redir https://arc-hive.xyz{uri} permanent
}

archive.62-171-153-35.sslip.io, arc-hive.xyz {
	encode gzip

	@console_newname {
		host arc-hive.xyz
		path /console /console/*
	}
	redir @console_newname https://archive.62-171-153-35.sslip.io{uri} 302

	# API de lecture, appairage des machines, mode test (l'API borne aussi chaque route à 64 Kio)
	handle_path /api/* {
		request_body {
			max_size 256KB
		}
		reverse_proxy api:8809
	}

	# copilote
	handle_path /copilot/* {
		request_body {
			max_size 512KB
		}
		reverse_proxy copilot:8808 {
			# 20/11 : l'origine arc-hive.xyz (notre site) est présentée comme celle de sslip.io (voir en tête)
			header_up Origin ^https://arc-hive\.xyz$ https://archive.62-171-153-35.sslip.io
			transport http {
				read_timeout 180s
			}
		}
	}

	# RPC public d'Arc testnet : même cible que le proxy de développement du front (frontend/vite.config.ts : /arc-rpc
	# vers https://rpc.testnet.arc.io). Pour les preuves d'état, une passerelle vers un nœud d'Arc
	# (deploy/arc-node/rpc-gate.mjs, host.docker.internal:8810) peut prendre sa place.
	@arcrpc path /arc-rpc /arc-rpc/*
	handle @arcrpc {
		uri strip_prefix /arc-rpc
		request_body {
			max_size 128KB
		}
		reverse_proxy https://rpc.testnet.arc.io {
			header_up Host {upstream_hostport}
			transport http {
				read_timeout 30s
			}
		}
	}

	# le copilote du nouveau site (surface « site » : il pilote les pages du front de Florent)
	handle_path /copilot-site/* {
		request_body {
			max_size 512KB
		}
		reverse_proxy copilot-site:8808 {
			# 20/11 : l'origine arc-hive.xyz (notre site) est présentée comme celle de sslip.io (voir en tête)
			header_up Origin ^https://arc-hive\.xyz$ https://archive.62-171-153-35.sslip.io
			transport http {
				read_timeout 180s
			}
		}
	}

	# serveur MCP en HTTP (Streamable HTTP, sans état) : d'autres agents (Claude, Cursor…) utilisent nos outils
	@mcp path /mcp /mcp/*
	handle @mcp {
		request_body {
			max_size 64KB
		}
		reverse_proxy mcp:8812
	}

	# site + proxy des enclaves (/enclave/inference/, /enclave/bounty/) : nginx du conteneur web
	handle {
		# l'enclave du copilote (/enclave/copilot-site/, derrière nginx) filtre aussi l'origine
		reverse_proxy web:80 {
			# 20/11 : l'origine arc-hive.xyz (notre site) est présentée comme celle de sslip.io (voir en tête)
			header_up Origin ^https://arc-hive\.xyz$ https://archive.62-171-153-35.sslip.io
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Scripts : seulement ceux du site (aucun script en ligne, aucun tiers)  ; 'wasm-unsafe-eval' pour le décodeur
		# meshopt de three.js (la scène 3D du front de Florent) : il compile du WebAssembly, pas de JavaScript (eval reste interdit). Connexions : le site lui-même (API,
		# copilote, proxy des enclaves), le RPC et l'explorateur d'Arc, les enclaves chez Phala et derrière un tunnel
		# cloudflared (inscription d'une machine : le navigateur lit son /attest), les RPC Sepolia et Base Sepolia de
		# la page Portefeuille (CCTP), WalletConnect, Coinbase Wallet et le résolveur ENS de RainbowKit.
		# Styles en ligne permis (RainbowKit injecte ses thèmes) ; images https (icônes de wallets) ; jamais cadré.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://iris-api-sandbox.circle.com https://rpc.testnet.arc.io https://explorer.testnet.arc.io https://*.phala.network https://*.trycloudflare.com https://ethereum-sepolia-rpc.publicnode.com https://base-sepolia-rpc.publicnode.com https://*.walletconnect.com wss://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.org https://enhanced-provider.rainbow.me https://api.wallet.coinbase.com wss://www.walletlink.org; frame-src https://verify.walletconnect.com https://verify.walletconnect.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# ni version ni logiciel annoncés (Server de nginx ou de Caddy, Via du proxy)
		-Server
		-Via
	}
}
