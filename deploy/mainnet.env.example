# Arc MAINNET — deployment parameters (contracts/script/Deploy.s.sol)
# No secret here: the deployment key is given to forge with --private-key or a keystore, never in this file.
#   forge script script/Deploy.s.sol --rpc-url https://rpc.mainnet.arc.io --broadcast   (after `set -a; source mainnet.env; set +a`)

# chainId 5042, gas paid in USDC (25 gwei on 7 Nov 2026)

# Arc's native USDC (ERC-20 interface, 6 decimals), checked on mainnet on 7 Nov 2026
USDC=0x3600000000000000000000000000000000000000

# Automata DCAP v1.1 was not on Arc mainnet on 7 Nov 2026 (0 bytes at 0xefE368b17D137E86298eec8EbC5502fb56d27832):
# deploy it first (PCCS + verifiers + Intel collateral for Phala's FMSPCs), then put its address here.
DCAP=0x_A_DEPLOYER

# Circle's ERC-8004 v2.0.0 validation registry on mainnet, checked on 7 Nov 2026
ERC8004_VALIDATION=0x8004Cc8439f36fd5F9F049D9fF86523Df6dAAB58

# Network treasury: a 2-of-3 multisig (both team members and a backup key). Never a single key.
TREASURY=0x_MULTISIG

# Delay before a product or a price change takes effect.
# 172800 (48 h): a session's price is locked when the session opens, so a price change never reaches an open session.
# 48 h is also the script's default, and Deploy.s.sol refuses anything below 48 h on Arc mainnet.
TIMELOCK=172800

# Bounties: 10 % to the network, 5 % to the verifying enclaves, on top of the tier paid to the hunter.
NETWORK_BOUNTY_BPS=1000
OPERATOR_BOUNTY_BPS=500

# Require SEPT_VE_DISABLE in the TD attributes: the real quote of ArcHive's Phala enclave has it (tdAttributes = 0x10000000, DEBUG = 0).
REQUIRE_SEPT_VE=1

# --- Products to create next (ProductRegistry.propose, then activate after the timelock) ---
# Private inference (CPU TDX): price=200 (0.0002 USDC per 1,000 input-equivalent tokens; output x4)
#                              bps 9500/0/500; minBond=100000000 (100 USDC); settlement=SessionPay; param=model hash
# Private inference GPU:       minBond=1000000000 (1,000 USDC); price set after measuring throughput
# Sealed Bounty:               price=0; deterministic=true; minBond=100000000 at launch (1,000 USDC later); settlement=SealedBounty
# Sealed Bounty, attempts:     price=10000 (0.01 USDC per attempt); minBond=100000000; settlement=SessionPay
