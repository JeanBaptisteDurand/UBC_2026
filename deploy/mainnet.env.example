# Arc MAINNET — paramètres du déploiement (contracts/script/Deploy.s.sol)
# Aucun secret ici : la clé de déploiement se passe à forge par --private-key ou un keystore, jamais dans ce fichier.
#   forge script script/Deploy.s.sol --rpc-url https://rpc.mainnet.arc.io --broadcast   (après `set -a; source mainnet.env; set +a`)

# chainId 5042, gas payé en USDC (25 gwei le 7/11)

# USDC natif d'Arc (interface ERC-20, 6 décimales) — VERIFIED mainnet 7/11
USDC=0x3600000000000000000000000000000000000000

# Automata DCAP v1.1 — ABSENT d'Arc mainnet au 7/11 (0 octet à 0xefE368b17D137E86298eec8EbC5502fb56d27832) :
# à déployer d'abord (PCCS + vérificateurs + collatéral Intel des FMSPC de Phala), puis mettre son adresse ici.
DCAP=0x_A_DEPLOYER

# ERC-8004 v2.0.0 de Circle — registre de validation mainnet, VERIFIED 7/11
ERC8004_VALIDATION=0x8004Cc8439f36fd5F9F049D9fF86523Df6dAAB58

# Trésor du réseau : multisig 2-sur-3 (JB, Florent, secours). Jamais une seule clé.
TREASURY=0x_MULTISIG

# Délai avant activation d'un produit ou d'un changement de prix.
# 172800 (48 h) avec la pile v2 (prix verrouillé à l'ouverture d'une session) ; 604800 (7 j) si v1.
# ATTENTION : le défaut du script est 300 s (5 min) — ne jamais déployer mainnet sans cette ligne.
TIMELOCK=172800

# Primes : 10 % au réseau, 5 % aux enclaves vérificatrices, en plus du palier payé au chasseur.
NETWORK_BOUNTY_BPS=1000
OPERATOR_BOUNTY_BPS=500

# Exiger SEPT_VE_DISABLE dans les attributs TD : le vrai quote de notre enclave Phala l'a (tdAttributes = 0x10000000, DEBUG = 0).
REQUIRE_SEPT_VE=1

# --- Produits à créer ensuite (ProductRegistry.propose puis activate après le timelock) ---
# Inférence privée (CPU TDX)  : price=200 (0,0002 USDC / 1 000 jetons-équivalent-entrée ; sortie x4)
#                               bps 9500/0/500 ; minBond=100000000 (100 USDC) ; settlement=SessionPay ; param=hash du modèle
# Inférence privée GPU        : minBond=1000000000 (1 000 USDC) ; prix fixé après mesure du débit
# Prime scellée               : price=0 ; deterministic=true ; minBond=100000000 au lancement (1 000 USDC ensuite) ; settlement=SealedBounty
# Prime scellée — tentatives  : price=10000 (0,01 USDC / tentative) ; minBond=100000000 ; settlement=SessionPay
