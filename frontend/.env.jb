# Public build settings, no secrets: Vite embeds every VITE_* value in the published site.
# jb profile: the site is served at the root of the ArcHive API origin (console under /console/, 3D room under
# /datacenter/). All URLs are relative to that origin: /api, /copilot-site, /enclave/…, /arc-rpc.
VITE_PROFILE=jb
VITE_BASE=/
# Expected operator of the attested copilot (product 4): not used by the site panel (it calls /copilot-site).
VITE_COPILOT_OPERATOR=
