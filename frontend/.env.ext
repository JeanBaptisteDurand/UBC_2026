# Public build settings, no secrets: Vite embeds every VITE_* value in the published site.
# ext profile: the site is served elsewhere over HTTPS and calls the public ArcHive API origin.
# That origin must allow the site origin: SIGN_ORIGINS (API), ALLOWED_ORIGINS (copilot and copilot enclave).
VITE_PROFILE=ext
VITE_JB_ORIGIN=https://archive.62-171-153-35.sslip.io
VITE_COPILOT_OPERATOR=
